# Golden Hive - Docker Compose settings. Copy to ".env" and change the secrets for anything beyond a local demo.
# .env is ignored by git.

POSTGRES_PASSWORD=goldenhive
# At least 32 characters; every service validates the JWTs with this key.
GOLDENHIVE_JWT_KEY=change-me-golden-hive-demo-signing-key-0123456789
# Key for service-to-service calls of /internal endpoints (never routed by the gateway).
GOLDENHIVE_INTERNAL_KEY=change-me-golden-hive-internal-key
# Port of the API gateway on the host.
GOLDENHIVE_PORT=8080
# true = error responses contain exception details (development only).
GOLDENHIVE_SHOW_ERROR_DETAILS=false

# AI agent: "rules" (offline, deterministic) or "openai" (any OpenAI-compatible endpoint).
GOLDENHIVE_AI_PROVIDER=rules
GOLDENHIVE_AI_ENDPOINT=https://api.openai.com/v1
GOLDENHIVE_AI_API_KEY=
GOLDENHIVE_AI_MODEL=gpt-4o-mini
# Rules agent: invoices above this amount are handed to a person.
GOLDENHIVE_AI_REVIEW_ABOVE=20000

# Optional Windows push (WNS) for users without a live connection.
GOLDENHIVE_WNS_CLIENT_ID=
GOLDENHIVE_WNS_CLIENT_SECRET=
