<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GoldenHive.NET.WinUI.Framework.Host.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Golden Hive">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Golden Hive">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/GoldenHive.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="PaletteBox"
                    MinWidth="220"
                    MaxWidth="560"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    QuerySubmitted="OnPaletteQuerySubmitted"
                    TextChanged="OnPaletteTextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <Border x:Name="ShellHost" Grid.Row="1" />
    </Grid>
</Window>
