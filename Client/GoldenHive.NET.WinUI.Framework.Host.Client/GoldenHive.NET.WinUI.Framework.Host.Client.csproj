<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GoldenHive.NET.WinUI.Framework.Host.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GoldenHive.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\GoldenHive.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties (no trimming: modules are loaded dynamically, see ARCHITECTURE.md rule 8) -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>
  <!-- Framework libraries composed by the host -->
  <ItemGroup>
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Windowing\GoldenHive.NET.WinUI.Framework.Windowing.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Security\GoldenHive.NET.WinUI.Framework.Security.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.XamlMetadata\GoldenHive.NET.WinUI.Framework.XamlMetadata.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Mvvm\GoldenHive.NET.WinUI.Framework.Mvvm.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Commands\GoldenHive.NET.WinUI.Framework.Commands.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.ModuleLoader\GoldenHive.NET.WinUI.Framework.ModuleLoader.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Navigation\GoldenHive.NET.WinUI.Framework.Navigation.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.NotificationClient\GoldenHive.NET.WinUI.Framework.NotificationClient.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.HotSwap\GoldenHive.NET.WinUI.Framework.HotSwap.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Workflows\GoldenHive.NET.WinUI.Framework.Workflows.csproj" />
    <ProjectReference Include="..\GoldenHive.NET.WinUI.Framework.Docking\GoldenHive.NET.WinUI.Framework.Docking.csproj" />
  </ItemGroup>

  <!--
    Development modules: the module clients are built with the host (not referenced as assemblies - they are loaded
    at runtime into their own AssemblyLoadContext). Each module build stages its dll + manifest.json into
    artifacts\modules\<moduleId>\ (see Modules\ModuleClient.targets); they are copied to Modules\ next to the host
    (and into the MSIX layout). The ModuleStore discovers them as "development" modules, so the client works
    offline and before the packages were uploaded to the ModuleDelivery service.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\DocumentManagement\Client\GoldenHive.NET.Modules.DocumentManagement.Client.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\Modules\Reporting\Client\GoldenHive.NET.Modules.Reporting.Client.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\Modules\UserManagement\Client\GoldenHive.NET.Modules.UserManagement.Client.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="IncludeDevelopmentModules" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_DevelopmentModuleFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\modules\**\*.*" />
      <Content Include="@(_DevelopmentModuleFile)" Link="Modules\%(_DevelopmentModuleFile.RecursiveDir)%(_DevelopmentModuleFile.Filename)%(_DevelopmentModuleFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Message Importance="high" Text="Development modules: @(_DevelopmentModuleFile->Count()) files" />
  </Target>

</Project>