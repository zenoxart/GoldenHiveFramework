<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GoldenHive.NET.WinUI.Framework.Host.Client.Views.DemoModuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gh="using:GoldenHive.NET.WinUI.Framework.Commands">

    <Grid Padding="28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock
            Grid.Row="1"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Opacity="0.8"
            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button gh:Ui.Command="shell.view.detach" />
            <Button gh:Ui.Command="shell.navigationwheel.show" />
        </StackPanel>
        <TextBlock Grid.Row="3" gh:Ui.Text="shell:demo.view.text" Opacity="0.75" TextWrapping="Wrap" />
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="Single" />
    </Grid>
</UserControl>
