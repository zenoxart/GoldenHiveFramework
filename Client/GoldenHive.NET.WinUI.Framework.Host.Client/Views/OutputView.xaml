<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GoldenHive.NET.WinUI.Framework.Host.Client.Views.OutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gh="using:GoldenHive.NET.WinUI.Framework.Commands"
    xmlns:mvvm="using:GoldenHive.NET.WinUI.Framework.Mvvm">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="8">
            <Button gh:Ui.Icon="clear" gh:Ui.Text="shell:output.clear" Click="OnClear" />
            <CheckBox
                x:Name="AutoScrollBox"
                gh:Ui.Text="shell:output.autoscroll"
                Checked="OnAutoScrollChanged"
                Unchecked="OnAutoScrollChanged" />
        </StackPanel>

        <ListView
            x:Name="LogList"
            Grid.Row="1"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="Extended">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mvvm:LogEntry">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Opacity="0.6" Text="{x:Bind TimeText}" />
                        <TextBlock Grid.Column="1" Opacity="0.8" Text="{x:Bind TypeText}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
