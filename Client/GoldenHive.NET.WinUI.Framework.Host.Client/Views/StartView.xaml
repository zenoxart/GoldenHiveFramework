<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GoldenHive.NET.WinUI.Framework.Host.Client.Views.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gh="using:GoldenHive.NET.WinUI.Framework.Commands"
    xmlns:views="using:GoldenHive.NET.WinUI.Framework.Host.Client.Views">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="32,28,32,32"
            Spacing="28">

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="88"
                    Height="88"
                    Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock gh:Ui.Text="shell:start.welcome" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock gh:Ui.Text="shell:start.subtitle" Opacity="0.75" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock gh:Ui.Text="shell:start.quickactions" Style="{StaticResource SubtitleTextBlockStyle}" />
                <VariableSizedWrapGrid
                    ItemHeight="44"
                    ItemWidth="250"
                    Orientation="Horizontal">
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="shell.palette" />
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="shell.navigationwheel.show" />
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="shell.view.detach" />
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="navigate.shell.settings" />
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="shell.language.toggle" />
                    <Button Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" gh:Ui.Command="shell.layout.reset" />
                </VariableSizedWrapGrid>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock gh:Ui.Text="shell:start.modules" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView
                    IsItemClickEnabled="True"
                    ItemClick="OnModuleClick"
                    ItemsSource="{x:Bind ViewModel.Modules}"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="views:ModuleCard">
                            <Grid
                                Width="300"
                                Height="112"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="14"
                                CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="28"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        MaxLines="3"
                                        Opacity="0.75"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock gh:Ui.Text="shell:start.tips" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock gh:Ui.Text="shell:start.tip.wheel" TextWrapping="Wrap" />
                <TextBlock gh:Ui.Text="shell:start.tip.palette" TextWrapping="Wrap" />
                <TextBlock gh:Ui.Text="shell:start.tip.float" TextWrapping="Wrap" />
                <TextBlock gh:Ui.Text="shell:start.tip.responsive" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
